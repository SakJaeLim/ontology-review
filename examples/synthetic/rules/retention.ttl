@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix demo: <urn:demo:> .

demo:RetentionShape a sh:NodeShape ;
    sh:targetNode demo:project ;
    sh:property [ sh:path demo:retentionDays ; sh:datatype xsd:integer ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 1 ; sh:maxInclusive 60 ] .
